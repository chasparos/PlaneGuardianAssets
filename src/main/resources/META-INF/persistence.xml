<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
        Persistence unit for the PlaneGuardian asset library.
        The JDBC URL is overridden at runtime by DatabaseManager.initialize()
        so only the driver, dialect and DDL mode are defined here.
    -->
    <persistence-unit name="planeguardian-assets" transaction-type="RESOURCE_LOCAL">
        <class>com.planeguardian.assets.model.Asset</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="hibernate.dialect"               value="org.hibernate.dialect.H2Dialect"/>
            <!-- Schema is auto-created / migrated on first run -->
            <property name="hibernate.hbm2ddl.auto"          value="update"/>
            <property name="hibernate.show_sql"              value="false"/>
        </properties>
    </persistence-unit>

</persistence>
